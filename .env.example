SECRET_KEY=replace-with-a-long-random-secret
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# Local MySQL development
MYSQL_DATABASE=fitbite
MYSQL_USER=fitbite_user
MYSQL_PASSWORD=replace-with-your-local-password
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306

# Optional SMTP configuration
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=your-user@example.com
EMAIL_HOST_PASSWORD=your-password
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=FitBite <noreply@example.com>

# Optional analytics / verification
GA4_MEASUREMENT_ID=
GSC_VERIFICATION=
SITE_URL=http://127.0.0.1:8000

# Production on Render uses DATABASE_URL instead of the MYSQL_* values.
